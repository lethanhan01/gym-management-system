# ==============================================================================
# APPLICATION SETTINGS
# ==============================================================================
NODE_ENV=production
PORT=3000
CLIENT_URL=https://gym.yourdomain.com
PERMISSION_CACHE_TTL_MS=60000

# ==============================================================================
# DATABASE CONFIGURATION
# ==============================================================================
# Option 1: PostgreSQL on Host VPS (recommended for VPS deployment)
# Khi container ket noi den PostgreSQL cai tren Host VPS (qua host.docker.internal):
DB_CONNECTION_MODE=direct
DATABASE_URL=postgresql://rogym:<password>@host.docker.internal:5432/rogym?sslmode=disable&connection_limit=10&pool_timeout=10&connect_timeout=10&application_name=gym-api
DIRECT_URL=postgresql://rogym:<password>@host.docker.internal:5432/rogym?sslmode=disable

# Option 2: Supabase PostgreSQL (Managed Cloud DB)
# DB_CONNECTION_MODE=supavisor-session
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres?sslmode=require&connection_limit=5&pool_timeout=5&connect_timeout=5&application_name=gym-api
# DIRECT_URL=postgresql://postgres.<project-ref>:<password>@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres

# ==============================================================================
# AUTHENTICATION
# ==============================================================================
# Generate a strong 64-char random string: openssl rand -base64 48
JWT_SECRET=change_me_to_a_secure_jwt_secret_key_in_production
JWT_EXPIRES_IN=7d
QR_CHECKIN_SECRET=
DEVICE_API_KEY=

# Demo master OTP - leave EMPTY in real production
DEMO_MASTER_OTP=

# ==============================================================================
# EXERCISE DB SYNC (OPTIONAL)
# ==============================================================================
EXERCISEDB_API_KEY=
EXERCISEDB_SYNC_ENABLED=false
EXERCISEDB_SCHEDULER_ENABLED=false
EXERCISEDB_SYNC_CRON=0 3 * * 0
EXERCISEDB_TIMEOUT_MS=15000
EXERCISEDB_PAGE_SIZE=50
EXERCISEDB_UPSERT_BATCH_SIZE=50
EXERCISEDB_MIN_EXPECTED_COUNT=1
EXERCISEDB_RETRY_LIMIT=3
EXERCISEDB_LOCK_LEASE_SECONDS=300

# ==============================================================================
# LINE LOGIN & MESSAGING (OPTIONAL)
# ==============================================================================
LINE_MOCK_ENABLED=false
LINE_CHANNEL_ID=
LINE_CHANNEL_SECRET=
LINE_MESSAGING_ENABLED=false
LINE_CHANNEL_ACCESS_TOKEN=
LINE_LIFF_URL=https://liff.line.me/<LIFF_ID>
LINE_COVER_IMAGE_URL=
LINE_MESSAGE_LOCALE=vi
LINE_REMINDER_MINUTES=30
LINE_RICH_MENU_ID=

# ==============================================================================
# SMTP (OPTIONAL)
# ==============================================================================
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=
