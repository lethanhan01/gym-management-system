# Application
NODE_ENV=development
PORT=3000
CLIENT_URL=http://localhost:5173
PERMISSION_CACHE_TTL_MS=60000

# Database (Supabase / PostgreSQL)
# Runtime URL for Prisma. For Supabase, use the Transaction pooler on port 6543.
# URL-encode special characters in the password.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@<pooler-host>:6543/postgres?sslmode=require&pgbouncer=true&connection_limit=5&pool_timeout=20&connect_timeout=20

# DDL URL for Prisma db push/generate. Prefer direct connection on port 5432.
# If direct/IPv6 access is blocked, use the Session pooler on port 5432 instead.
DIRECT_URL=postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres?sslmode=require

# Auth
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d

# Demo only. Leave empty in real production.
DEMO_MASTER_OTP=


# ExerciseDB / RapidAPI (optional; server falls back to local exercises when empty)
EXERCISEDB_API_KEY=

# LINE login and messaging (optional)
LINE_CHANNEL_ID=
LINE_CHANNEL_SECRET=
LINE_MESSAGING_ENABLED=false
LINE_CHANNEL_ACCESS_TOKEN=
LINE_LIFF_URL=
LINE_MESSAGE_LOCALE=vi
LINE_REMINDER_MINUTES=30

# SMTP is accepted by config validation but current OTP flow only logs codes.
# Uncomment when an SMTP sender is implemented/enabled.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
