# Application
NODE_ENV=development
PORT=3000
CLIENT_URL=http://localhost:5173

# Database (Supabase / PostgreSQL)
# DATABASE_URL: Transaction pooler (port 6543) — runtime queries
# DIRECT_URL: Session pooler or direct (port 5432) — DDL / prisma db push
DATABASE_URL=postgresql://postgres:<password>@<host>:6543/<db>?pgbouncer=true
DIRECT_URL=postgresql://postgres:<password>@<host>:5432/<db>

# JWT
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d

# SMTP (optional — required for password reset / email verification)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Device API Key (optional — required for real-time check-in feature)
DEVICE_API_KEY=

# LINE LIFF
LINE_CHANNEL_ID=
