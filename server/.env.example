# Application
NODE_ENV=development
PORT=3000
CLIENT_URL=http://localhost:5173
PERMISSION_CACHE_TTL_MS=60000

# Database (Supabase / PostgreSQL)
# Runtime URL for the persistent Nest backend. Do not use the transaction pooler
# (:6543) here and do not add pgbouncer=true. URL-encode special characters.
# Use this mode when the deployment is IPv4-only.
DB_CONNECTION_MODE=supavisor-session
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-<region>.pooler.supabase.com:5432/postgres?sslmode=require&connection_limit=5&pool_timeout=5&connect_timeout=5&application_name=gym-api
# Alternative for deployments with IPv6 connectivity or the Supabase IPv4 add-on:
# DB_CONNECTION_MODE=direct
# DATABASE_URL=postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres?sslmode=require&connection_limit=5&pool_timeout=5&connect_timeout=5&application_name=gym-api

# Serverless/edge is out of scope for this backend. If added later, it needs its
# own deployment path with Supavisor transaction mode (:6543), pgbouncer=true,
# connection_limit=1, and dedicated tests.

# Auth
JWT_SECRET=change-me-in-production
QR_CHECKIN_SECRET=
JWT_EXPIRES_IN=7d

# API key for POST /api/v1/devices/access-events (optional until device integration is enabled)
DEVICE_API_KEY=

# Demo only. Leave empty in real production.
DEMO_MASTER_OTP=


# ExerciseDB catalog sync through RapidAPI (the backend never exposes this key)
# RapidAPI key for exercisedb.p.rapidapi.com.
EXERCISEDB_API_KEY=
EXERCISEDB_SYNC_ENABLED=false
# Keep false for one-shot imports. Set true only for an intentionally recurring sync.
EXERCISEDB_SCHEDULER_ENABLED=false
EXERCISEDB_SYNC_CRON=0 3 * * 0
EXERCISEDB_TIMEOUT_MS=15000
# One-shot full-catalog runbook: PAGE_SIZE=10, UPSERT_BATCH_SIZE=100,
# MIN_EXPECTED_COUNT=<preflight manifest count>, RETRY_LIMIT=0.
EXERCISEDB_PAGE_SIZE=50
EXERCISEDB_UPSERT_BATCH_SIZE=50
# Set from a successful staging import before importing production.
EXERCISEDB_MIN_EXPECTED_COUNT=1
EXERCISEDB_RETRY_LIMIT=3
EXERCISEDB_LOCK_LEASE_SECONDS=300

# LINE login and messaging (optional)
# Local LIFF Mock only. Keep false or omit in deployed environments.
LINE_MOCK_ENABLED=false
# LINE_CHANNEL_ID is the numeric ID of the LINE Login channel that owns the LIFF app.
# VITE_LIFF_ID (client) is the full LIFF ID, e.g. 2010144670-0RjWIyfv.
# LINE_LIFF_URL is the public LIFF URL. Do not paste the Endpoint URL or Developers Console URL.
LINE_CHANNEL_ID=
LINE_CHANNEL_SECRET=
LINE_MESSAGING_ENABLED=false
LINE_CHANNEL_ACCESS_TOKEN=
LINE_LIFF_URL=https://liff.line.me/<LIFF_ID>
LINE_MESSAGE_LOCALE=vi
LINE_REMINDER_MINUTES=30

# SMTP is accepted by config validation but current OTP flow only logs codes.
# Uncomment when an SMTP sender is implemented/enabled.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=no-reply@example.com
