@startuml
start

:受付;
if (新規登録か?) then (Yes)
  :個人情報を入力;
  :電話番号とメールの重複を確認;
else (No)
  :会員番号を入力;
  :前のプラン状態を確認;
endif

:プランを選択;

:データを入力または更新;

:合計金額を計算;

:決済する;

if (決済成功か?) then (Yes)
  :プランを更新;
  :利用権限を有効化;
  :領収書を出力;
  stop
else (No)
  :エラーを表示;
  if (再試行するか?) then (Yes)
    :支払方法を選び直す;
    --> :決済する;
  else (No)
    :申請を中止;
    stop
  endif
endif

@enduml